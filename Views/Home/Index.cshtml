@model ShortestPathApp.ViewModels.GraphViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Сравнение алгоритмов: Беллман-Форд vs Дейкстра</title>
    <style>
        :root { 
            --bg: #ffffff; --fg: #111; --border: #ccc; --accent-bellman: #d9534f; --accent-dijkstra: #0056b3; 
        }
        body { font-family: 'Segoe UI', sans-serif; margin: 0; padding: 20px; background: var(--bg); color: var(--fg); }
        .container { max-width: 1400px; margin: 0 auto; }
        
        h1 { text-align: center; border-bottom: 2px solid var(--fg); padding-bottom: 10px; }
        
        /* Форма ввода */
        .input-panel { background: #f9f9f9; padding: 20px; border: 1px solid var(--border); margin-bottom: 20px; }
        .form-row { display: flex; gap: 15px; align-items: center; margin-bottom: 10px; flex-wrap: wrap; }
        button { background: #333; color: #fff; border: none; padding: 10px 20px; cursor: pointer; font-weight: bold; }
        button:hover { background: #555; }
        textarea { width: 100%; height: 80px; font-family: monospace; }

        /* Сетка сравнения */
        .comparison-grid {
            display: grid;
            grid-template-columns: 1fr 1fr; /* Две равные колонки */
            gap: 20px;
        }
        
        .algo-card {
            border: 1px solid var(--border);
            padding: 15px;
            background: #fff;
        }
        
        .algo-header {
            font-size: 1.2em;
            font-weight: bold;
            margin-bottom: 15px;
            padding-bottom: 5px;
            border-bottom: 2px solid;
            text-align: center;
        }
        
        .bellman-theme .algo-header { border-color: var(--accent-bellman); color: var(--accent-bellman); }
        .dijkstra-theme .algo-header { border-color: var(--accent-dijkstra); color: var(--accent-dijkstra); }

        .graph-box { border: 1px solid #eee; background: #fff; max-height: 400px; overflow: auto; margin-bottom: 15px; }
        
        .metrics-list { font-size: 0.9em; background: #fafafa; padding: 10px; border: 1px solid #eee; margin-bottom: 10px; }
        .metrics-list div { margin-bottom: 5px; display: flex; justify-content: space-between; }
        
        .policy-box { font-family: monospace; font-size: 0.8em; max-height: 150px; overflow-y: auto; border: 1px solid #eee; padding: 5px; }
        
        .error-box { background: #fee; color: #c00; padding: 10px; margin: 10px 0; border: 1px solid #fcc; }

       @@media (max-width: 900px) {
    .comparison-grid { grid-template-columns: 1fr; } /* На мобильных в одну колонку */
}
    </style>
</head>
<body>
    <div class="container">
        <h1>Сравнительный анализ алгоритмов поиска пути</h1>

        <!-- Панель ввода данных (общая для обоих) -->
        <form method="post" asp-controller="Home" asp-action="Calculate" class="input-panel">
            <div class="form-row">
                <label>Вершин:</label>
                <input type="number" name="VertexCount" value="@(Model.VertexCount)" style="width:80px" />
                <button type="submit" name="action" value="Generate">Сгенерировать граф</button>
            </div>
            <div class="form-row">
                <label>От:</label> <input type="number" name="Source" value="@Model.Source" style="width:60px" />
                <label>До:</label> <input type="number" name="Target" value="@Model.Target" style="width:60px" />
            </div>
            <textarea name="RawEdges" placeholder="Введите рёбра вручную (From,To,Weight)...">@Model.RawEdges</textarea>
            <div style="margin-top:10px; text-align:right;">
                <button type="submit" name="action" value="Calculate">Рассчитать оба алгоритма</button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="error-box">@Model.ErrorMessage</div>
        }

        <!-- Сетка сравнения -->
        <div class="comparison-grid">
            
            <!-- ЛЕВАЯ КОЛОНКА: Беллман-Форд -->
            <div class="algo-card bellman-theme">
                <div class="algo-header">Алгоритм Беллмана-Форда</div>
                
                @if (!string.IsNullOrEmpty(Model.BellmanSvg))
                {
                    <div class="graph-box">@Html.Raw(Model.BellmanSvg)</div>
                    
                    @if (Model.BellmanPath.Any())
                    {
                        <div style="font-weight:bold; color:var(--accent-bellman); margin-bottom:10px;">
                            Путь: @string.Join(" → ", Model.BellmanPath) (Вес: @Model.BellmanResult?.Distances[Model.Target])
                        </div>
                    }

                    <div class="metrics-list">
                        <div><span>Время:</span> <b>@Model.BellmanResult?.ExecutionTimeMs.ToString("F2") мс</b></div>
                        <div><span>Итераций:</span> <b>@Model.BellmanResult?.IterationsCount</b></div>
                        <div><span>Проверок рёбер:</span> <b>@Model.BellmanResult?.TotalEdgeChecks</b></div>
                        <div><span>Релаксаций:</span> <b>@Model.BellmanResult?.SuccessfulRelaxations</b></div>
                    </div>

                    <div class="policy-box">
                        @if (Model.BellmanResult?.PathPolicies != null) {
                            foreach(var p in Model.BellmanResult.PathPolicies) { <div>@p</div> }
                        }
                    </div>
                }
                else {
                    <div style="text-align:center; padding:40px; color:#999;">Ожидание расчёта...</div>
                }
            </div>

            <!-- ПРАВАЯ КОЛОНКА: Дейкстра -->
            <div class="algo-card dijkstra-theme">
                <div class="algo-header">Алгоритм Дейкстры</div>
                
                @if (!string.IsNullOrEmpty(Model.DijkstraSvg))
                {
                    <div class="graph-box">@Html.Raw(Model.DijkstraSvg)</div>
                    
                    @if (Model.DijkstraPath.Any())
                    {
                        <div style="font-weight:bold; color:var(--accent-dijkstra); margin-bottom:10px;">
                            Путь: @string.Join(" → ", Model.DijkstraPath) (Вес: @Model.DijkstraResult?.Distances[Model.Target])
                        </div>
                    }

                    <div class="metrics-list">
                        <div><span>Время:</span> <b>@Model.DijkstraResult?.ExecutionTimeMs.ToString("F2") мс</b></div>
                        <div><span>Итераций (Вершин):</span> <b>@Model.DijkstraResult?.IterationsCount</b></div>
                        <div><span>Проверок рёбер:</span> <b>@Model.DijkstraResult?.TotalEdgeChecks</b></div>
                        <div><span>Релаксаций:</span> <b>@Model.DijkstraResult?.SuccessfulRelaxations</b></div>
                    </div>

                    <div class="policy-box">
                        @if (Model.DijkstraResult?.PathPolicies != null) {
                            foreach(var p in Model.DijkstraResult.PathPolicies) { <div>@p</div> }
                        }
                    </div>
                }
                else {
                     <div style="text-align:center; padding:40px; color:#999;">
                        @(Model.InputEdges.Any() ? "Не рассчитан (возможно, есть отрицательные веса)" : "Ожидание расчёта...")
                     </div>
                }
            </div>

        </div>
    </div>
</body>
</html>